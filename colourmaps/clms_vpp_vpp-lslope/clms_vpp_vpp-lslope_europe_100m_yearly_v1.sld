              <ColorMapEntry quantity="100.0" color="#2a788e" opacity="1.0" label="0.010"/>
              <ColorMapEntry quantity="200.0" color="#23a884" opacity="1.0" label="0.020"/>
              <ColorMapEntry quantity="300.0" color="#7ad151" opacity="1.0" label="0.030"/>
              <ColorMapEntry quantity="450.0" color="#fde725" opacity="1.0" label="0.045"/>
